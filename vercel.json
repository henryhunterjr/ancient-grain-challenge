{
  "cleanUrls": true,
  "git": { "deploymentEnabled": { "feature/muse-quiz-score-handoff": false } },
  "headers": [
    {
      "source": "/record-score",
      "headers": [
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "X-Robots-Tag", "value": "noindex" }
      ]
    },
    {
      "source": "/admin",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ]
}
